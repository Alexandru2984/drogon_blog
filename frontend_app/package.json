    "vue-router": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/vue3-vite": "^10.4.1",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.5.0",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.6.0",
    "storybook": "^10.4.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
