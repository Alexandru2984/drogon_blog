[Unit]
Description=Drogon Blog — daily PostgreSQL backup (timer)
Documentation=file:/home/micu/drogon_blog/scripts/backup.sh

[Timer]
# 02:30 UTC daily — well outside the European-hours read traffic peak
# but late enough that any nightly content edits from late-night
# authors have settled.
OnCalendar=*-*-* 02:30:00 UTC

# Persistent=true catches up on a missed run if the VPS was down at
# 02:30 (kernel update, power cut). Without it, an outage that
# bridged the scheduled minute would silently skip that day's dump.
Persistent=true

# Jitter avoids stampeding pg_dump against other timers that happen
# to share the 02:30 slot (apt nightly, system journal vacuum…).
RandomizedDelaySec=5min

# Each run waits for the previous Service to complete before firing
# again — pg_dump rarely takes more than seconds on this size DB, but
# the guard rail is free.
Unit=drogon-blog-backup.service

[Install]
WantedBy=timers.target
