[Unit]
Description=Drogon Blog Server
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=micu
Group=micu
WorkingDirectory=/home/micu/drogon_blog
ExecStart=/home/micu/drogon_blog/build/blog
EnvironmentFile=/home/micu/drogon_blog/.env

Restart=on-failure
RestartSec=5

# One file descriptor per connection, so this is the real ceiling on how many
# visitors can be connected at once — not config.json's `max_connections`,
# which was set to 4096 and could never be reached.
#
# systemd's default is a soft limit of 1024 against a hard limit of 524288,
# and it is the soft one that binds. Drogon never raises its own, so the
# process stopped accepting at 1024 open descriptors — about 880 usable once
# the database pool, listeners and Redis have taken theirs. Measured: while
# 1024 were held, the kernel had 1470 connections established that the
# application could not pick up, and a new visitor got no response at all.
# Not a 503, not a reset — silence until their client gave up.
#
# 65536 rather than the hard limit: it is far above anything this box will
# see, and leaving headroom below the hard limit keeps a runaway descriptor
# leak from consuming the host instead of just this service. Idle connections
# cost about 7 KB each here (measured: 900 of them moved RSS from 57 to 63
# MB), so the memory implied by this ceiling is on the order of 450 MB.
LimitNOFILE=65536

# ---- Sandboxing ----
# Defence-in-depth so an RCE in a C++ parser (libvips / cmark / grpc / libpq)
# is confined. Kept compatible with running in-tree as User=micu: the app
# lives under /home/micu/drogon_blog and must read its code/config there, so
# ProtectHome stays off and we use ProtectSystem=strict (whole FS read-only)
# plus an explicit ReadWritePaths for the only directory it writes — uploads.
# Logs go to journald (stdout), so nothing else needs write access.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
# ProtectSystem=strict alone leaves the user's home writable on this host, so
# pin the app tree read-only explicitly (verified: a write to the repo root is
# then blocked) while ReadWritePaths re-grants the uploads subdir.
ReadOnlyPaths=/home/micu/drogon_blog
ReadWritePaths=/home/micu/drogon_blog/uploads
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
# TCP (HTTP/PG/Redis/SMTP/gRPC) + AF_UNIX (journald) + AF_NETLINK (glibc
# getaddrinfo interface enumeration). No raw sockets.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
# Binds only high ports (8092 HTTP, 50051 gRPC) so no capabilities are needed.
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

# Graceful shutdown window.
#
# main.cc's SIGTERM handler: flip /readyz to 503, sleep 2 s for the
# upstream LB to notice, close all WebSockets with a normal-close
# frame, then app().quit() drains in-flight HTTP. The bulk of the
# wall-clock cost is the 2 s drain sleep + however long the longest
# in-flight DB query takes; 30 s is a comfortable ceiling under all
# realistic load shapes. After TimeoutStopSec systemd escalates to
# SIGKILL — past that point we accept the kill rather than risk a
# wedged unit blocking other deploys.
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
