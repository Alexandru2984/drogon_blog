# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=blog_db
DB_USER=blog_user
DB_PASSWORD=change-me

# SMTP (leave empty to disable real delivery — emails will be logged and dropped)
SMTP_SERVER=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=Micu's Blog

# Set to 1 when the app is served over TLS (production). This does two
# things: it flips the `Secure` flag on the session and CSRF cookies, and
# it switches both cookie names to the `__Host-` prefixed form
# (`__Host-JSESSIONID`, `__Host-csrf_token`). The prefix is enforced by the
# browser as "Secure + Path=/ + no Domain attribute", which is what stops a
# sibling vhost on the same registrable domain from overwriting them.
# Leave unset for local HTTP development — browsers reject `__Host-`
# cookies that lack Secure, so the app would lose its session entirely.
BLOG_SECURE_COOKIES=

# Override the session cookie name. Normally leave this empty: main.cc
# derives it from BLOG_SECURE_COOKIES above. Only set it if you need to
# pin a specific name (e.g. sharing a session store with another service).
BLOG_SESSION_COOKIE=

# Encrypt TOTP shared secrets at rest. Generate once with:
#   openssl rand -hex 32
# and keep the value stable. Exactly 64 hexadecimal characters are required.
# The app refuses to start without this key when BLOG_SECURE_COOKIES=1 and
# refuses malformed configured values in every environment.
BLOG_TOTP_KEY=

# Which request header may declare the client IP. Only consulted when the
# connection's peer matches BLOG_TRUSTED_PROXIES. The reverse proxy MUST
# strip inbound copies of whatever is named here — see
# ops/nginx/blog-proxy.conf — otherwise clients can spoof their own IP and
# rotate past every per-IP rate limit. Default: X-Real-IP.
BLOG_CLIENT_IP_HEADER=

# Thread pools for work that must not run on a Drogon event loop.
#
# Auth covers Argon2id (~167 ms per hash on a modern core, by design) and
# the synchronous queries in the auth / 2FA flows. Its size is a memory
# bound as much as a CPU one: libsodium's INTERACTIVE limit is 64 MiB per
# concurrent hash, so the default of 4 caps Argon2id at 256 MiB regardless
# of how many logins arrive at once. Media covers libvips; that library
# parallelises internally, so extra workers mostly contend.
#
# Defaults: 4 and 2, each capped at the core count.
BLOG_AUTH_WORKERS=
BLOG_MEDIA_WORKERS=

# Check candidate passwords against Have I Been Pwned before accepting them.
# Uses k-anonymity: only the first five hex characters of the password's
# SHA-1 are sent, so the service never learns the password or its full hash,
# nor which of the ~800 returned candidates was yours.
#
# Off by default because it puts an outbound HTTPS request on the
# registration and password-change paths, which an operator should opt into
# rather than discover. Fails open — a timeout or outage accepts the
# password rather than taking signups down with it.
BLOG_HIBP_ENABLED=

# Sentry DSN, backend. The frontend has its own, VITE_SENTRY_DSN, read at
# build time in frontend_app/src/main.ts. Both sides are fully wired and
# both are inert while unset — the SDK is present in the bundle but
# Sentry.init is skipped, and helpers/Sentry.cc logs "disabled" and returns.
#
# Deliberately unset on blog.micutu.com, decided 2026-08-08. Sentry's value
# here would be grouping and deduplicating exceptions, not noticing them:
# Prometheus scrapes the service and alerts by email on downtime, 5xx rate,
# latency, restart loops and worker-pool shedding (ops/prometheus/alerts.yml),
# and journald already holds the traces. Set it if you want the grouping.
#
# Accepts https://<public_key>@<host>/<project_id>. The deprecated
# secret-key form is rejected.
BLOG_SENTRY_DSN=
